# NOTE: '${CMAKE_SOURCE_DIR}/src/CMakeLists.txt.in' is used to dynamically generate 
# '${CMAKE_BINARY_DIR}/${PROJECT_NAME}/CMakeLists.txt'
# in which it will be Included immediately after `configure_file()`
# is called.

# NOTE: This generated file (in build dir) will assume that it will be include()'d
# hence, one should assume all variables are already defined (externally) and will be
# inherited.  Will need to check if for example, if I call `project(foobar)` here,
# it will override caller or not.
# (Interestingly, all variables newly defined here will propagate up to the original caller)
# This means there are NO NEED to `set(CMAKE_CXX_STANDARD 17)` etc.
if(Windows OR WIN32 OR MSYS OR MINGW OR OS_WINDOWS)
  set(OS_WINDOWS TRUE)
  message(STATUS "${PROJECT_NAME}: Template for Windows")
elseif(Linux OR ( UNIX AND NOT APPLE) OR OR_LINUX)
  set(OS_LINUX TRUE)
  message(STATUS "${PROJECT_NAME}: Template for Linux")
elseif(Darwin OR APPLE OR OS_MAC)
  set(OS_MAC TRUE)
  message(STATUS "${PROJECT_NAME}: Template for Mac")
else()
    message(FATAL_ERROR "${PROJECT_NAME}: Unsupported platform")
endif()

# Set the current source directory to ./src
set(CMAKE_CURRENT_SOURCE_DIR ${CMAKE_SOURCE_DIR}/src)

# make sure CMAKE_SOURCE_DIR && CMAKE_CURRENT_SOURCE_DIR exists
if(NOT DEFINED CMAKE_SOURCE_DIR OR NOT DEFINED CMAKE_CURRENT_SOURCE_DIR)
    message(FATAL_ERROR "${PROJECT_NAME}: CMAKE_SOURCE_DIR or CMAKE_CURRENT_SOURCE_DIR is not defined")
endif()
# make sure directory exists
if(NOT EXISTS ${CMAKE_CURRENT_SOURCE_DIR})
    message(FATAL_ERROR "${PROJECT_NAME}: CMAKE_CURRENT_SOURCE_DIR does not exist: ${CMAKE_CURRENT_SOURCE_DIR}")
endif()
# does src/win exist?
if(NOT EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/win")
  message(FATAL_ERROR "Cannot find directory: ${CMAKE_CURRENT_SOURCE_DIR}/win") 
endif()
# does src/mac exist?
if(NOT EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/mac")
  message(FATAL_ERROR "Cannot find directory: ${CMAKE_CURRENT_SOURCE_DIR}/mac") 
endif()
# Ensure the Info.plist.in file is correctly referenced
# because the configure_file command (which is executed as part of
# MACOSX_BUNDLE_INFO_PLIST) uses global env variables and would insert the
# wrong values with multiple targets.
set(MAC_INFO_PLIST_IN "${CMAKE_CURRENT_SOURCE_DIR}/mac/Info.plist.in")
if(NOT EXISTS "${MAC_INFO_PLIST_IN}")
  message(FATAL_ERROR "Cannot find source file: ${MAC_INFO_PLIST_IN}")
endif()
set(MACOSX_BUNDLE_INFO_PLIST  "${CMAKE_CURRENT_SOURCE_DIR}/mac/Info.plist.in")
message(STATUS "${PROJECT_NAME}: MAC_INFO_PLIST_IN: '${MAC_INFO_PLIST_IN}' (CMAKE_CURRENT_SOURCE_DIR=${CMAKE_CURRENT_SOURCE_DIR})")
message(STATUS "${PROJECT_NAME}: MACOSX_BUNDLE_INFO_PLIST: '${MACOSX_BUNDLE_INFO_PLIST}' (CMAKE_CURRENT_SOURCE_DIR=${CMAKE_CURRENT_SOURCE_DIR})")

